{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gremio-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // El frontend se sirve como archivos estáticos (no cuentan contra el límite de peticiones);
  // solo /api/* pasa por el código del Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // La descarga no cupo en 10 ms de CPU y la hace GitHub Actions (.github/workflows/precios.yml).
  // Este Cron solo le pide a GitHub que la corra, porque su horario propio se retrasa o se salta
  // (src/despertador.ts). Necesita el secreto GITHUB_TOKEN.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  // Registra CPU y logs de cada invocación en el panel de Cloudflare (incluido en el plan gratuito).
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "PRECIOS",
      "id": "7caf9b437b524880aff6c838b204142c",
    },
  ],
}
